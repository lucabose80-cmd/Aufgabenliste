<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_reading_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:padding="10dp"
    android:gravity="center_vertical">

    <!-- Compact Book Selector Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_surface_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/btn_prev_book"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#9AA0A6"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_book_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Buch wählen"
            android:textColor="#E3E3E3"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_next_book"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#9AA0A6"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Compact Timer Block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:gravity="center"
        android:orientation="vertical">

        <Chronometer
            android:id="@+id/chronometer_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A8C7FA"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_paused_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#E3E3E3"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_timer_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bereit"
            android:textColor="#9AA0A6"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Compact Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_toggle_timer"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:maxLines="1"
            android:text="Start"
            android:textColor="#062E6F"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_finish_timer"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_danger"
            android:gravity="center"
            android:maxLines="1"
            android:text="Stopp"
            android:textColor="#F2B8B5"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
